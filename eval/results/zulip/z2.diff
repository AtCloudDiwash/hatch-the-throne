+    # The name is the text before the first "/" or space. If a space
+    # comes first, the name continues through any following words,
+    # until a digit, "(" or "/" begins the version or other details.
+    name_end = _find_first_of(user_agent, " /")
+    if name_end < len(user_agent) and user_agent[name_end] == " ":
+        words_end = _find_first_of(user_agent, DIGITS + "/(", name_end)
+        if words_end < len(user_agent) and user_agent[words_end] != "/":
+            # A digit or "(" does not belong to the name, and neither
+            # does the word right before it.
+            words_end = user_agent.rfind(" ", name_end, words_end)
+        name_end = words_end
+
+    name = user_agent[:name_end]
+    version = None
+    if user_agent[name_end : name_end + 1] == "/":
